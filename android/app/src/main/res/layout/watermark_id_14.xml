<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="mainViewModel"
            type="com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.watermark.model.BaseWatermarkViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/waterMarkMargin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="@dimen/dp_6"
        android:orientation="horizontal"
        android:backgroundWith30Transparency="@{mainViewModel.watermarkModel.templateColor}"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.WaterMarkMapWidget
                android:id="@+id/watermarkMapWidget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >
            </com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.WaterMarkMapWidget>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="top"
                android:layout_gravity="top"
                android:paddingHorizontal="@dimen/dp_6"
                app:layout_constraintStart_toEndOf="@+id/watermarkMapWidgetLayout"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    >
                   <ImageView
                       android:layout_width="@dimen/dp_20"
                       android:layout_height="@dimen/dp_20"
                       android:background="@drawable/location"
                       />
                    <androidx.appcompat.widget.AppCompatTextView
                    android:layout_marginStart="@dimen/dp_6"
                    android:id="@+id/locationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    text="@{mainViewModel.locationText}"
                    android:maxLines="5"
                        android:maxWidth="@dimen/dp_240"
                    android:textSize="@dimen/dp_12"
                    android:gravity="left"
                    android:textColor="@{mainViewModel.watermarkModel.textColor}"
                    />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    >
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        > <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:background="@drawable/calendar"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:layout_marginStart="@dimen/dp_6"
                        android:id="@+id/dateText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="@{mainViewModel.dateText}"
                        android:textSize="@dimen/dp_12"
                        android:gravity="left"
                        android:textColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="@dimen/dp_20"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        >
                        <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/lat"
                            android:tint="@color/red_map_icon"
                            tools:ignore="UseAppTint"

                            />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_marginStart="@dimen/dp_6"
                            android:id="@+id/lat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            text="@{mainViewModel.lat}"
                            android:textSize="@dimen/dp_12"
                            android:gravity="left"
                            android:textColor="@{mainViewModel.watermarkModel.textColor}"
                            />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/dp_6"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_vertical"
                    >
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        > <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:background="@drawable/id14icontimer"
                        />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_marginStart="@dimen/dp_6"
                            android:id="@+id/clockText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            text='@{mainViewModel.amPmTimeZoneWeek +" "+mainViewModel.hmText}'
                            android:textSize="@dimen/dp_12"
                            android:gravity="left"
                            android:textColor="@{mainViewModel.watermarkModel.textColor}"
                            />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginStart="@dimen/dp_20"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        android:layout_gravity="center_vertical"
                        android:gravity="center_vertical"
                        > <ImageView
                        android:layout_width="@dimen/dp_20"
                        android:layout_height="@dimen/dp_20"
                        android:src="@drawable/lng"
                        android:tint="@color/red_map_icon"
                        tools:ignore="UseAppTint"
                        />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:layout_marginStart="@dimen/dp_6"
                            android:id="@+id/lng"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            text="@{mainViewModel.lng}"
                            android:textSize="@dimen/dp_12"
                            android:gravity="left"
                            android:textColor="@{mainViewModel.watermarkModel.textColor}"
                            />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerItemList"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
