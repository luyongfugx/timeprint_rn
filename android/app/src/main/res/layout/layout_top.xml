<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/default_icons"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="horizontal">
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"

        android:paddingLeft="@dimen/dp_12">

        <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.IconFontTextView
            android:id="@+id/toggle_flash"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text=""
            android:gravity="center"
            android:textSize="24sp"
            android:textColor="#ffffff" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/toggle_timer"
            style="@style/Widget.App.Button.OutlineButton.IconOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="timer"
            android:gravity="center"
            android:layout_toEndOf="@+id/toggle_flash"
            app:iconTint="@color/white"
            app:iconSize="24dp"
            app:iconPadding="0dp"
            app:icon="@drawable/timer"
            />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/logoButton"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_centerInParent="true"
            android:text="@string/i_logo"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:cornerRadius="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/white"
            android:backgroundTint="@android:color/transparent"
            />
    </RelativeLayout>

    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingRight="@dimen/dp_20"
        android:layout_weight="1">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/change_resolution"
            style="@style/Widget.App.Button.OutlineButton.IconOnly"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:contentDescription="ratio"
            android:layout_toStartOf="@+id/settings"
            tools:icon="@drawable/ic_photo_4x3_vector" />
        <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.IconFontTextView
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text=""
            android:gravity="center"
            android:textSize="24sp"
            android:layout_alignParentEnd="true"
            android:textColor="#ffffff" />

    </RelativeLayout>

</LinearLayout>
