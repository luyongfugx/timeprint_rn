<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <import type="android.view.View" />
        <variable
            name="mainViewModel"
            type="com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.watermark.model.BaseWatermarkViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/waterMarkMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:id="@+id/watermark_header"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            tools:ignore="MissingConstraints">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginLeft="@dimen/dp_2"
                android:layout_marginRight="@dimen/dp_2"
                >
                <LinearLayout
                    android:id="@+id/watermark_id1_hmText"
                    android:layout_weight="4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="@dimen/dp_6"
                    >
                    <ImageView
                        android:id="@+id/watermark_hm_h1"
                        android:layout_width="@dimen/dp_14"
                        android:layout_height="@dimen/dp_28"
                        android:srcDrawable="@{mainViewModel.hm01}"
                        android:layout_marginEnd="@dimen/dp_2"
                        android:tintColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                    <ImageView
                        android:id="@+id/watermark_hm_h2"
                        android:layout_width="@dimen/dp_14"
                        android:layout_height="@dimen/dp_28"
                        android:srcDrawable="@{mainViewModel.hm02}"
                        android:layout_marginEnd="@dimen/dp_2"
                        android:tintColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                    <ImageView
                        android:id="@+id/watermark_hm_colon"
                        android:layout_width="@dimen/dp_6"
                        android:layout_height="@dimen/dp_32"
                        android:src="@drawable/grey_colon"
                        android:layout_marginEnd="@dimen/dp_2"
                        android:paddingBottom="@dimen/dp_6"
                        android:tintColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                    <ImageView
                        android:id="@+id/watermark_hm_h3"
                        android:layout_width="@dimen/dp_14"
                        android:layout_height="@dimen/dp_28"
                        android:srcDrawable="@{mainViewModel.hm03}"
                        android:layout_marginEnd="@dimen/dp_2"
                        android:tintColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                    <ImageView
                        android:id="@+id/watermark_hm_h4"
                        android:layout_width="@dimen/dp_14"
                        android:layout_height="@dimen/dp_28"
                        android:srcDrawable="@{mainViewModel.hm04}"
                        android:tintColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/right_title"
                    android:layout_weight="6"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    android:gravity="center_vertical|end"
                    android:layout_gravity="center_vertical|end"
                    android:layout_marginRight="@dimen/dp_6"
                    >
                    <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.AutoFitTextView
                        android:id="@+id/watermark_id1_weekText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxWidth="@dimen/dp_200"
                        android:layout_marginLeft="@dimen/dp_10"
                        text="@{mainViewModel.amPmTimeZoneWeek}"
                        android:textColor="@{mainViewModel.watermarkModel.textColor}"
                        android:textSize="@dimen/dp_12"
                        android:layout_gravity="left"
                        />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/watermark_id1_dateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_10"
                        text="@{mainViewModel.dateText}"
                        android:textSize="@dimen/dp_12"
                        android:gravity="left"
                        android:textColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <View
            android:id="@+id/watermark_line"
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="@dimen/dp_6"
            app:layout_constraintTop_toBottomOf="@+id/watermark_header"
            android:background="@{mainViewModel.watermarkModel.templateColor}"
            tools:ignore="MissingConstraints" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItemList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_40"
            android:minWidth="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/watermark_line"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>