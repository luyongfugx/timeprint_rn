<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <import type="android.view.View" />
        <variable
            name="mainViewModel"
            type="com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.watermark.model.BaseWatermarkViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/waterMarkMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:id="@+id/digit_clock"
            android:layout_width="@dimen/dp_228"
            android:layout_height="@dimen/dp_83"
            android:background="@drawable/clock_bg"
            android:orientation="vertical"
            android:padding="@dimen/dp_12"
            tools:ignore="MissingConstraints">
                <LinearLayout
                android:id="@+id/digit_date_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_16"
                 >
                    <LinearLayout
                    android:id="@+id/watermark_date"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_horizontal"
                    android:layout_gravity="center_horizontal"
                    >
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[0]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[1]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[2]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[3]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[4]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[5]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[6]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[7]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[8]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_11"
                        android:layout_height="@dimen/dp_16"
                        android:srcDrawable="@{mainViewModel.id9DateDrawableList[9]}"
                        />
                </LinearLayout>
                </LinearLayout>
                <LinearLayout
                android:id="@+id/digit_time_layout"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                    android:layout_weight="1"

                >
                <LinearLayout
                    android:id="@+id/time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_gravity="center"
                    >
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[0]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[1]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[2]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[3]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[4]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[5]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[6]}"
                        />
                    <ImageView
                        android:layout_width="@dimen/dp_21"
                        android:layout_height="@dimen/dp_31"
                        android:srcDrawable="@{mainViewModel.id9TimeDrawableList[7]}"
                        />
                </LinearLayout>
                </LinearLayout>
        </LinearLayout>
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/remember_this_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            text="@{mainViewModel.watermarkTitle}"
            android:textSize="@dimen/dp_18"
            app:layout_constraintTop_toBottomOf="@+id/digit_clock"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:textColor="@{mainViewModel.watermarkModel.textColor}"
            />
        <LinearLayout
            android:id="@+id/address_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/remember_this_time"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="left"
            android:layout_gravity="left"
            >
            <ImageView
                android:id="@+id/location_dot"
                android:layout_width="@dimen/dp_28"
                android:layout_height="@dimen/dp_31"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:background="@drawable/clock_location_white"
                android:backgroundTint="@{mainViewModel.watermarkModel.templateColor}"
                />
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/address"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                text="@{mainViewModel.locationText}"
                android:textSize="@dimen/dp_18"
                android:maxWidth="@dimen/dp_240"
                app:layout_constraintStart_toEndOf="@+id/location_dot"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="left"
                android:layout_gravity="left"
                android:textColor="@{mainViewModel.watermarkModel.textColor}"
                />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItemList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/dp_40"
            android:minWidth="@dimen/dp_100"
            android:layout_marginTop="@dimen/dp_6"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/remember_this_time"
            />
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>