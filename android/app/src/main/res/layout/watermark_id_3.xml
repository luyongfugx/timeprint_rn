<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="mainViewModel"
            type="com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.watermark.model.BaseWatermarkViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/waterMarkMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="wrap_content"
            android:orientation="vertical"
            android:layout_height="@dimen/dp_80"
            android:minWidth="@dimen/dp_100"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginLeft="@dimen/dp_2"
            android:layout_marginRight="@dimen/dp_2"
            android:background="@drawable/bg_radius_6_ffffff"
            >
            <LinearLayout
                android:id="@+id/watermark_title_container"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_top_radius_06_ffffff"
                android:backgroundTint="@{mainViewModel.watermarkModel.templateColor}"
                >
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/watermark_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    text="@{mainViewModel.watermarkTitle}"
                    android:textSize="@dimen/dp_18"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="@{mainViewModel.watermarkModel.textColor}"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/watermark_hm_text_box"
                android:layout_weight="1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="center"
                android:layout_gravity="center"
                android:background="@drawable/bg_bottom_radius_6_ffffff"
                >
                <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.BigShouldersRegularTextView
                    android:id="@+id/watermark_hmText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    text="@{mainViewModel.hmText}"
                    android:textFontWeight="900"
                    android:textStyle="bold"
                    android:textSize="@dimen/dp_28"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="@{mainViewModel.watermarkModel.templateColor}"
                    />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clock_container_bottom"
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clock_container"
            android:layout_marginLeft="@dimen/dp_2"
            android:layout_marginRight="@dimen/dp_2"
            android:paddingTop="6dp"
            >
        <View
            android:id="@+id/watermark_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@{mainViewModel.watermarkModel.templateColor}"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerItemList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/dp_6"
            android:minHeight="@dimen/dp_40"
            android:minWidth="@dimen/dp_100"
            app:layout_constraintStart_toEndOf="@+id/watermark_line"
            app:layout_constraintTop_toTopOf="parent"
            />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
