<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="android.view.View" />
        <variable
            name="mainViewModel"
            type="com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.watermark.model.BaseWatermarkViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/waterMarkMargin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >
        <LinearLayout
            android:id="@+id/clock_container"
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:background="@drawable/bg_radius_4_ffffff"
            android:padding="@dimen/dp_6"
            >
            <LinearLayout
                android:id="@+id/watermark_title_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/dp_4"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_gravity="center"
                android:background="@drawable/bg_radius_4_f0f0f0"
                android:backgroundTint="@{mainViewModel.watermarkModel.templateColor}"
                >
                <androidx.appcompat.widget.AppCompatImageView
                    android:id="@+id/check_view"
                    android:layout_width="@dimen/dp_20"
                    android:layout_height="@dimen/dp_20"
                    android:tint="@{mainViewModel.watermarkModel.textColor}"
                    android:src="@drawable/ic_check_vector"
                     />
                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/watermark_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/dp_2"
                    text="@{mainViewModel.watermarkTitle}"
                    android:textSize="@dimen/dp_16"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:textColor="@{mainViewModel.watermarkModel.textColor}"
                    />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/watermark_id1_hmText"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="@dimen/dp_6"
                >
                <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.BigShouldersRegularTextView
                    android:id="@+id/watermark_hm_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    text="@{mainViewModel.hmText}"
                    android:textSize="@dimen/dp_24"
                    android:layout_marginHorizontal="@dimen/dp_2"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@{mainViewModel.watermarkModel.templateColor}"
                    />
            </LinearLayout>
        <LinearLayout
            android:id="@+id/logo_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="@dimen/dp_6"
            android:visibility="@{mainViewModel.logoOpen ? View.VISIBLE : View.GONE}"
            >
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo_image"
                android:layout_marginHorizontal="@dimen/dp_2"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:visibility='@{mainViewModel.logoDrawable ? View.VISIBLE : View.GONE}'
                android:src="@drawable/timeprint"
                />
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo_image_1"
                android:layout_marginHorizontal="@dimen/dp_2"
                android:layout_width="@dimen/dp_32"
                android:layout_height="@dimen/dp_32"
                android:visibility='@{mainViewModel.logoDrawable ? View.GONE : View.VISIBLE}'
                android:src="@{ mainViewModel.logoUrl}"
                />
        </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/clock_container_bottom"
            android:layout_width="wrap_content"
            android:orientation="horizontal"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clock_container"
            android:layout_marginLeft="@dimen/dp_2"
            android:layout_marginRight="@dimen/dp_2"
            android:paddingTop="6dp"
            >
        <View
            android:id="@+id/watermark_line"
            android:layout_width="2dp"
            android:layout_height="match_parent"
            app:layout_constraintStart_toStartOf="parent"
            android:background="@{mainViewModel.watermarkModel.templateColor}"
            />
            <LinearLayout
                android:id="@+id/items_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:minWidth="@dimen/dp_100"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toEndOf="@+id/watermark_line"
                android:layout_marginLeft="@dimen/dp_2"
                android:layout_marginRight="@dimen/dp_2"
                >
                <LinearLayout
                    android:id="@+id/top_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="left"
                    android:layout_gravity="left"
                    android:paddingHorizontal="2dp"
                    >
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/topRecyclerItemList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/dp_100"
                        android:layout_marginLeft="@dimen/dp_6"
                        app:layout_constraintTop_toTopOf="parent"
                        />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/bottom_items"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/top_items"
                    android:gravity="left"
                    android:layout_gravity="left"
                    android:layout_marginTop="@dimen/dp_6"
                    >
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerItemList"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/dp_6"
                        android:layout_marginRight="@dimen/dp_6"

                        />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
