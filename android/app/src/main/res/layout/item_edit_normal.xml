<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/clEditSingleLine"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:paddingStart="@dimen/dp_14">

    <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.GpSwitch
        android:id="@+id/switch_edit"
        android:layout_width="@dimen/dp_45"
        android:layout_height="@dimen/dp_10"
        android:background="@drawable/switch_selector"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@id/tv_edit_item_content_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_edit_item_content_container"
        app:thumbTint="@color/transparent"
        app:trackTint="@color/transparent" />
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/tv_edit_item_content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/dp_20"
        app:layout_constraintBottom_toBottomOf="@id/content_inner"
        app:layout_constraintStart_toEndOf="@id/switch_edit"

        app:layout_constraintEnd_toStartOf="@id/iv_edit_arrow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_goneMarginEnd="@dimen/dp_8"
        app:layout_goneMarginStart="@dimen/dp_4">

    <TextView
        android:id="@+id/tv_edit_item_content"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lines="1"
        android:textColor="@color/gray"
        android:textSize="@dimen/textSize17"
        app:layout_constraintEnd_toStartOf="@id/titleEnd"
        app:layout_constraintStart_toStartOf="parent"
        tools:text=""
        tools:ignore="MissingConstraints" />
        <Space
            android:id="@+id/titleEnd"
            android:layout_width="@dimen/dp_1"
            android:layout_height="match_parent"
            app:layout_constraintStart_toEndOf="@id/tv_edit_item_content"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/content_inner"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_05"
        android:layout_marginTop="@dimen/dp_50"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_edit_item_add_logo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="@id/switch_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/switch_edit">
        <ImageView
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:src="@drawable/add_icon"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_edit_item_logo"
        android:layout_width="@dimen/dp_40"
        android:layout_height="@dimen/dp_40"
        android:scaleType="centerInside"
        android:layout_marginRight="@dimen/dp_16"
        android:src="@android:drawable/ic_menu_gallery"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cl_edit_item_add_logo"
        app:layout_constraintTop_toTopOf="parent"
        tools:visibility="visible" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tryAgain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/dp_14"
        android:background="@drawable/bg_radius_4_bg_weak"
        android:paddingHorizontal="@dimen/dp_8"
        android:paddingVertical="@dimen/dp_6"
        android:text="Try again"
        android:textColor="@color/text_weak"
        android:textSize="@dimen/textSize16"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/iv_edit_arrow"
        android:layout_width="@dimen/dp_18"
        android:layout_height="@dimen/dp_18"
        android:layout_marginEnd="@dimen/dp_18"
        app:layout_constraintBottom_toBottomOf="@id/switch_edit"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/switch_edit"
        app:srcCompat="@drawable/arrow_right_gray" />
    <View
        android:id="@+id/vDividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/horizontalDividerColor"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>