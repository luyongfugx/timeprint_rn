<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top">

    <LinearLayout
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="top"
        android:layout_marginRight="@dimen/dp_6"
        android:paddingTop="@dimen/dp_6"
        android:visibility="gone"
        android:id="@+id/water_mark_item_dot_wrapper">

        <View
            android:id="@+id/water_mark_item_dot"
            android:layout_width="4dp"
            android:layout_height="8dp"
            android:background="@color/white" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:layout_marginRight="@dimen/dp_6"
        android:visibility="gone"
        android:id="@+id/water_mark_item_icon_wrapper">
        <ImageView
            android:id="@+id/water_mark_item_icon"
            android:layout_width="@dimen/dp_16"
            android:layout_height="@dimen/dp_16"
            android:src="@drawable/clock_location_white"
            android:scaleType="fitXY"
            app:tint="@color/white" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top"
        android:layout_marginLeft="@dimen/dp_08"
        android:id="@+id/water_mark_item_text_wrapper">
    <TextView
        android:id="@+id/water_mark_item_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:maxWidth="320dp"
       />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="top"
        android:layout_marginLeft="@dimen/dp_08"
        android:visibility="visible"
        android:id="@+id/water_mark_item_text_circleView_wrapper">
    <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.CircularCharacterView
        android:id="@+id/water_mark_item_text_circleView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/dp_2"
        />
    </LinearLayout>
</LinearLayout>