<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!--    <FrameLayout-->
<!--        android:id="@+id/watermark_edit_header"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        app:layout_constraintTop_toTopOf="parent" />-->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/edit_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:overScrollMode="never"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_bg" />
    <View
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_1"
        android:background="#0A000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottom_bg"/>

    <View
        android:id="@+id/bottom_bg"
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_68"
        android:background="#FAFAFA"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/color_size_btn"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/dp_44"
        android:gravity="center"
        android:layout_marginStart="@dimen/dp_16"
        android:textSize="@dimen/textSize16"
        android:text="@string/k_color_size"
        android:textColor="@color/color_555555"
        android:paddingEnd="@dimen/dp_9"
        android:paddingStart="@dimen/dp_9"
        android:drawablePadding="@dimen/dp_5"
        android:background="@drawable/bg_radius_5_db"
        android:layout_marginEnd="@dimen/dp_12"
        android:inputType="textCapWords"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edit_complete"
        app:layout_constraintBottom_toBottomOf="@id/edit_complete" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/edit_complete"
        android:layout_width="@dimen/dp_0"
        android:layout_height="@dimen/dp_44"
        android:gravity="center"
        android:textStyle="bold"
        android:textSize="@dimen/textSize17"
        android:text="@string/i_done"
        android:drawablePadding="@dimen/dp_5"
        android:layout_marginEnd="@dimen/dp_16"
        app:layout_goneMarginStart="@dimen/dp_16"
        android:layout_marginTop="@dimen/dp_12"
        android:textColor="@color/white"
        android:background="@drawable/bg_btn_primary_normal"
        tools:background="@drawable/bg_btn_primary_normal"
        app:layout_constraintStart_toEndOf="@id/color_size_btn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/bottom_bg" />

</androidx.constraintlayout.widget.ConstraintLayout>