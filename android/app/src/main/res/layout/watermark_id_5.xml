<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    >
    <data>
        <import type="android.view.View" />
        <variable
            name="mainViewModel"
            type="com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.watermark.model.BaseWatermarkViewModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        style="@style/waterMarkMargin"
        android:layout_width="@dimen/dp_260"
        android:maxWidth="@dimen/dp_320"
        android:layout_height="wrap_content"
        >
        <LinearLayout
                android:id="@+id/clock_container"
                android:layout_width="match_parent"
                android:minWidth="@dimen/dp_200"
                android:layout_height="0dp"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                >
                <LinearLayout
                    android:id="@+id/watermark_text_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_top_radius_4_f0f0f0"
                    android:backgroundTint="@{androidx.core.graphics.ColorUtils.setAlphaComponent(mainViewModel.watermarkModel.templateColor, (int) (0.7 * 255))}"
                    android:visibility="@{ mainViewModel.watermarkSubtitle.length > 0 || mainViewModel.watermarkTitle.length > 0 ? View.VISIBLE : View.GONE}"
                    >
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/watermark_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="@{mainViewModel.watermarkTitle}"
                        android:textSize="@dimen/dp_18"
                        android:textStyle="italic|bold"
                        android:layout_marginLeft="@dimen/dp_6"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:textColor="@{mainViewModel.watermarkModel.textColor}"
                        />
                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/watermark_subtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        text="@{mainViewModel.watermarkSubtitle}"
                        android:textSize="@dimen/dp_14"

                        android:layout_marginLeft="@dimen/dp_6"
                        android:gravity="center"
                        android:layout_gravity="center"
                        android:textColor="@{mainViewModel.watermarkModel.textColor}"
                        android:visibility="@{ mainViewModel.watermarkSubtitle.length > 0 ? View.VISIBLE : View.GONE}"
                        />
                    <ImageView
                        android:id="@+id/watermark_line"
                        android:layout_width="match_parent"
                        android:paddingHorizontal="@dimen/dp_4"
                        android:layout_height="6dp"
                        android:layout_marginTop="@dimen/dp_6"
                        app:layout_constraintTop_toBottomOf="@+id/watermark_title"
                        android:src="@drawable/arrow_line"
                        android:scaleType="fitXY"
                        />
                </LinearLayout>
              
                <LinearLayout
                    android:id="@+id/watermark_time_content"

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/watermark_line"
                        android:background="@color/color_FFF0F0"
                    android:backgroundTint="@{androidx.core.graphics.ColorUtils.setAlphaComponent(mainViewModel.watermarkModel.templateColor, (int) (0.7 * 255))}"
                        >
                    <LinearLayout
                        android:id="@+id/watermark_time_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        >
                        <LinearLayout
                            android:id="@+id/watermark_id1_hmText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_gravity="center_vertical"
                            android:layout_marginLeft="@dimen/dp_6"
                            >
                            <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.BigShouldersRegularTextView
                                android:id="@+id/watermark_hm_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                text="@{mainViewModel.hmText}"

                                android:textSize="@dimen/dp_32"
                                android:gravity="center_vertical"
                                android:layout_gravity="center_vertical"
                                android:textColor="@{mainViewModel.watermarkModel.textColor}"
                                />
                        </LinearLayout>
                        <LinearLayout
                            android:id="@+id/right_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            app:layout_constraintStart_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            android:gravity="center_vertical|start"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginRight="@dimen/dp_6"
                            >
                            <com.timestampcamerafree.gpsmapcameratimemark.geotagginglocationonphoto.views.widget.AutoFitTextView
                                android:id="@+id/watermark_id1_weekText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxWidth="@dimen/dp_120"
                                android:layout_marginLeft="@dimen/dp_10"
                                text="@{mainViewModel.amPmTimeZoneWeek}"
                                android:textColor="@{mainViewModel.watermarkModel.textColor}"
                                android:textSize="@dimen/dp_12"
                                android:layout_gravity="left"
                                />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/watermark_id1_dateText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/dp_10"
                                text="@{mainViewModel.dateText}"
                                android:textSize="@dimen/dp_12"
                                android:gravity="left"
                                android:textColor="@{mainViewModel.watermarkModel.textColor}"
                                />
                        </LinearLayout>

                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/watermark_line_2_content"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:paddingHorizontal="@dimen/dp_4"
                        app:layout_constraintTop_toBottomOf="@+id/watermark_time_container"
                        >
                                        <ImageView
                                            android:id="@+id/watermark_line_2"
                                            android:layout_width="match_parent"
                                            android:layout_height="6dp"
                                            app:layout_constraintStart_toStartOf="parent"
                                            app:layout_constraintEnd_toEndOf="parent"
                                            android:src="@drawable/arrow_line"
                                            android:scaleType="fitXY"
                                            />
                    </LinearLayout>

                    </LinearLayout>

                <LinearLayout
                    android:id="@+id/clock_container_bottom"
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/watermark_time_content"
                    android:paddingVertical="6dp"

                    android:background="@{androidx.core.graphics.ColorUtils.setAlphaComponent(mainViewModel.watermarkModel.templateColor, (int) (0.7 * 255))}"
                    >

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/recyclerItemList"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/dp_6"
                            android:layout_marginRight="@dimen/dp_6"
                            android:minHeight="@dimen/dp_40"
                            android:minWidth="@dimen/dp_60"
                            android:maxWidth="@dimen/dp_80"
                            />
                </LinearLayout>
            </LinearLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>
