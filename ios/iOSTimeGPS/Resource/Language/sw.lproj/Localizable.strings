"k_faq_issue1_title" = "1. Wakati sio sahihi";
"k_faq_issue1_content" = "Tafadhali angalia mtandao wako wa simu ili kuhakikisha kuwa umeunganishwa na mtandao wa intaneti, kisha anzisha upya App na jaribu tena.";
"k_faq_issue2_title" = "2. Badilisha muda";
"k_faq_issue2_content" = "Timeprint inahakikisha wakati halisi kulingana na wakati wa mtandao na haiwezi kubadilishwa. Ikiwa unataka kubadilisha wakati, tafadhali pakua na utumie TimeFix:\nhttps://itunes.apple.com/app/id6753891513";
"k_faq_issue3_title" = "3. Anwani si sahihi";
"k_faq_issue3_content" = "Tafadhali angalia mtandao wako wa simu ili kuhakikisha kuwa umeunganishwa na mtandao wa intaneti na kuwezesha vibali vya eneo. Ikiwa anwani sio ile unayotaka, tafadhali hariri alama ya maji, kisha gonga kuingiza anwani na uchague anwani unayotaka kutoka kwenye orodha ya anwani.";
