"k_faq_issue3_title" = "3. አድራሻ ትክክል አይደለም";
"k_faq_issue3_content" = "እባክዎን ሞባይል ኔትዎርክዎን ወደ ኢንተርኔት እንደተገናኘ ለማረጋገጥ ያረጋግጡ እና የቦታ ፈቃዶችን ያንቁ። አድራሻው የሚፈልጉት ካልሆነ፣ እባክዎን የውሃ ምልክቱን ያርትዑ፣ ከዚያ የአድራሻ ግቤት ላይ ይንኩ እና ከአድራሻ ዝርዝር የሚፈልጉትን አድራሻ ይምረጡ።";
"k_faq_issue4_title" = "4. አድራሻን እንደገና ያስተካክሉ";
"k_faq_issue4_content" = "Timeprint እውነተኛ አድራሻን ያረጋግጣል እና ሊቀየር አይችልም። አድራሻን መቀየር ከፈለጉ፣ እባክዎ TimeFix ያውርዱ እና ይጠቀሙበት፡\nhttps://itunes.apple.com/app/id6753891513";
"k_modify_time" = "ሰዓትን አስተካክል";
